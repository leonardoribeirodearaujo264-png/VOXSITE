# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (Settings > Environment Variables).
# Nunca ponha valores reais neste arquivo: ele vai para o git.

# Mercado Pago (Suas integrações > Credenciais). Teste: credenciais de teste.
MP_ACCESS_TOKEN=
# Mercado Pago (Suas integrações > Webhooks > Assinatura secreta)
MP_WEBHOOK_SECRET=
# teste | producao  (teste abre o sandbox_init_point)
MP_AMBIENTE=

# Segredo que assina as chaves (o MESMO usado pelo app para conferir offline)
VOX_SEGREDO_LICENCA=

# Resend (envio do e-mail com a chave)
RESEND_API_KEY=
# Ex.: VOX Videos <chave@seudominio.com.br> (domínio verificado no Resend)
EMAIL_REMETENTE=

# Senha do /admin. Vazia = admin desligado.
ADMIN_SENHA=

# Postgres. A integração Supabase da Vercel já cria POSTGRES_URL (usado se DATABASE_URL
# estiver vazio). As tabelas são criadas sozinhas, com RLS ligado.
DATABASE_URL=

# Endereço público do site, sem barra no fim (vai no notification_url e nas back_urls)
NEXT_PUBLIC_SITE_URL=

# true (padrão) = licença só com pagamento. false = libera POST /api/licenca (grátis)
EXIGIR_PAGAMENTO=
# Quantos computadores por licença (padrão 2)
MAQUINAS_POR_LICENCA=
